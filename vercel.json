{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/rooms", "destination": "/internal.html" },
    { "source": "/rooms/:path*", "destination": "/internal.html" },
    { "source": "/annex", "destination": "/internal.html" },
    { "source": "/annex/:path*", "destination": "/internal.html" },
    { "source": "/facilities", "destination": "/internal.html" },
    { "source": "/facilities/:path*", "destination": "/internal.html" },
    { "source": "/blaze-and-jacob", "destination": "/internal.html" },
    { "source": "/blaze-and-jacob/:path*", "destination": "/internal.html" },
    { "source": "/about", "destination": "/internal.html" },
    { "source": "/about/:path*", "destination": "/internal.html" },
    { "source": "/gallery", "destination": "/internal.html" },
    { "source": "/gallery/:path*", "destination": "/internal.html" },
    { "source": "/contact", "destination": "/internal.html" },
    { "source": "/contact/:path*", "destination": "/internal.html" },
    { "source": "/booking", "destination": "/internal.html" },
    { "source": "/booking/:path*", "destination": "/internal.html" },
    { "source": "/blog", "destination": "/internal.html" },
    { "source": "/blog/:path*", "destination": "/internal.html" },
    { "source": "/manage-booking", "destination": "/internal.html" },
    { "source": "/manage-booking/:path*", "destination": "/internal.html" }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/hero-frames/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/supabase-config.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
